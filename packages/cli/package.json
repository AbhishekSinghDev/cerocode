{
  "name": "cerocode",
  "version": "1.0.2",
  "description": "Interactive terminal UI for chatting with CeroCode AI agents",
  "keywords": [
    "cli",
    "tui",
    "chat",
    "ai",
    "terminal",
    "coding-agent",
    "opentui",
    "bun"
  ],
  "author": "AbhishekSinghDev <abhishek.code.tech@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbhishekSinghDev/cerocode.git"
  },
  "bugs": {
    "url": "https://github.com/AbhishekSinghDev/cerocode/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "cerocode": "bin/cerocode"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch src/index.tsx",
    "build": "NODE_ENV=production bun build src/index.tsx --outdir dist --target bun --external react --external hono --external ai --external zod --external @opentui/core --external @opentui/react",
    "prepublishOnly": "bun run build",
    "clean": "git clean -xdf node_modules dist"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.67",
    "@opentui/core": "^0.4.5",
    "@opentui/react": "^0.4.5",
    "ai": "^7.0.64",
    "date-fns": "^4.4.0",
    "hono": "^4.13.0",
    "open": "^11.0.0",
    "opentui-spinner": "^0.0.7",
    "pretty-ms": "^9.3.0",
    "react": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cerocode/server": "workspace:*",
    "@cerocode/shared": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "^19.2.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
