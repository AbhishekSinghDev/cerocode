# Copy to .env and fill in the values.
# Bun loads .env from the working directory automatically.

# Postgres connection string (server + drizzle-kit)
DATABASE_URL=postgres://user:password@localhost:5432/cerocode

# Clerk authentication — the server requires both and throws at startup
# if either is missing.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Model provider API keys. Only the providers whose keys are set will work.
# Mistral is required for the default model (devstral-small-latest).
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
